# ──────────────────────────────────────────────────────────
# .env.example  —  실제 키 값은 들어있지 않은 템플릿입니다.
# 이 파일을 복사해서 `.env` 로 이름을 바꾸고, 각 값을 채워 넣으세요.
#   (Windows PowerShell) Copy-Item .env.example .env
# 실제 .env 파일은 .gitignore 에 의해 git에 올라가지 않습니다 (보안).
# 실제 키 값은 프로젝트 인수인계 시 담당자에게 별도로 전달받으세요.
# ──────────────────────────────────────────────────────────

# AI API Keys
# === Claude (Anthropic) ===
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=

# === Google Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=

# === Provider 선택 ===
# Primary provider: claude | openai | gemini
AI_PROVIDER=claude
# Fallback chain (comma-separated, optional - overrides default)
# AI_FALLBACK_CHAIN=claude,openai,gemini

# === Perplexity (선택) ===
PERPLEXITY_API_KEY=
